{
  "collectionName": "components_visual_components_text_medias",
  "info": {
    "displayName": "Text + Media",
    "icon": "dashboard",
    "description": ""
  },
  "options": {},
  "attributes": {
    "media": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "media_position": {
      "type": "enumeration",
      "required": true,
      "default": "left",
      "enum": [
        "left",
        "right"
      ]
    },
    "media_mobile_position": {
      "type": "enumeration",
      "required": true,
      "default": "top",
      "enum": [
        "top",
        "bottom"
      ]
    },
    "content": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "output": "HTML",
        "preset": "defaultHtml"
      }
    },
    "title": {
      "type": "string"
    }
  }
}
